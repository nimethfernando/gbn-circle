generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Event {
  id                   String           @id @default(cuid())
  title                String
  type                 String
  tier                 String           @default("GBN Circle")
  format               String           @default("Online")
  date                 DateTime
  startTime            String
  endTime              String
  timezone             String           @default("IST")
  image                String
  shortDescription     String
  fullDescription      String?
  eligibility          String
  allowVisitorRequests Boolean          @default(true)
  fee                  String           @default("Free")
  capacity             Int?
  venueName            String?
  venueAddress         String?
  venueCity            String?
  venueCountry         String?
  privateMeetingLink   String?
  meetingId            String?
  passcode             String?
  speakerHost          String?
  agenda               String?
  whatToExpect         String?
  additionalInfo       String?
  supportContact       String?
  status               String           @default("PUBLISHED")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  requests             VisitorRequest[]
}

model VisitorRequest {
  id                 String   @id @default(cuid())
  eventId            String
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fullName           String
  email              String
  phone              String
  country            String
  city               String
  companyName        String
  designation        String
  industry           String
  website            String?
  linkedIn           String?
  whyAttend          String
  collaborationGoals String
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ContactSubmission {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  companyName String?
  designation String?
  interest    String?  @default("Membership")
  message     String
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Blog {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  takeaways   String?
  image       String
  category    String   @default("Networking & Trust")
  readTime    String   @default("5 min read")
  authorName  String   @default("GBN Executive Board")
  authorRole  String   @default("Global Business Network Leadership")
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Member {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  company      String
  designation  String
  industry     String
  tier         String   @default("GBN Circle")
  city         String
  turnoverBand String
  status       String   @default("ACTIVE")
  linkedIn     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}